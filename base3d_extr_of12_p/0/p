FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    #includeEtc "caseDicts/setConstraintTypes"

    inlet
    {
        type            zeroGradient;
    }
    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    blades
    {
        type            zeroGradient;
    }
    sym
    {
        type            symmetryPlane;
    }
    top
    {
        type            symmetry;
    }
    sides
    {
        type            symmetry;
    }
    "(AMI|NC)(1|2)"
    {
        type            zeroGradient;
    }
}
