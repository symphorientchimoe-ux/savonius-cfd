FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        smoother        DICGaussSeidel;
        cacheAgglomeration no;
        maxIter         300;   // 50 plafonnait à chaque pas : divergence vers 1,2 s (22/10)
        tolerance       1e-6;
        relTol          0.01;
    }

    pFinal
    {
        $p;
        tolerance       1e-6;
        relTol          0;
    }

    "pcorr.*"
    {
        $p;
        tolerance       1e-3;
        relTol          0;
    }

    "(U|k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-7;
        relTol          0.1;
    }

    "(U|k|omega)Final"
    {
        $U;
        relTol          0;
    }
}

PIMPLE
{
    correctPhi          yes;
    correctMeshPhi      no;     // OpenFOAM 12, rotation de corps solide (comme le tutoriel mixerVessel2D)
    nOuterCorrectors    12;
    nCorrectors         3;
    nNonOrthogonalCorrectors 1;
    turbOnFinalIterOnly false;

    outerCorrectorResidualControl
    {
        p
        {
            tolerance       1e-3;
            relTol          0;
        }
        U
        {
            tolerance       1e-4;
            relTol          0;
        }
    }
}

relaxationFactors
{
    fields
    {
        p               0.3;
        pFinal          1;
    }
    equations
    {
        "(U|k|omega)"   0.6;
        "(U|k|omega)Final" 1;
    }
}

cache
{
    grad(U);
}

