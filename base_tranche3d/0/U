FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

Uinf            UINF;

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {
        // rampe lineaire de 0 a Uinf sur TRAMP s (demarrage progressif)
        type            uniformFixedValue;
        uniformValue    table ((0 (0 0 0)) (TRAMP ($Uinf 0 0)));
        value           uniform (0 0 0);
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform (0 0 0);
        value           uniform (0 0 0);
    }
    "(pales|pales_slave|arbre)"
    {
        type            movingWallVelocity;
        value           uniform (0 0 0);
    }
    "(sym|top)"
    {
        type            empty;
    }
    sides
    {
        type            symmetry;
    }
    AMI1
    {
        type            cyclicAMI;
        value           $internalField;
    }
    AMI2
    {
        type            cyclicAMI;
        value           $internalField;
    }
}
