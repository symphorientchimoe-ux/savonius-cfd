FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}

internalFacesOnly true;
baffles
{
    rotation
    {
        type        faceZone;
        zoneName    zoneTournante;
        patches
        {
            master { name AMI1; type cyclicAMI; neighbourPatch AMI2; }
            slave  { name AMI2; type cyclicAMI; neighbourPatch AMI1; }
        }
    }
}
